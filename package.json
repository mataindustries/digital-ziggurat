{
  "name": "digital-ziggurat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "metadata": "node scripts/generate-dead-channel-captions.mjs && node scripts/generate-public-metadata.mjs",
    "metadata:code": "node scripts/generate-public-metadata.mjs --code-only",
    "build": "npm run metadata && node scripts/check-dead-channel.mjs && vite build",
    "check:dead-channel": "node scripts/check-dead-channel.mjs",
    "check:dead-channel:release": "node scripts/check-dead-channel.mjs --release",
    "preview": "vite preview",
    "build:release": "npm run check:dead-channel:release && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {}
}
